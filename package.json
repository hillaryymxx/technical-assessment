{
  "name": "crosschainbule",
  "private": true,
  "version": "1.0.0",
  "description": "crosschainBule site and API",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/prepare-server.cjs",
    "dev": "node init && concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "next dev --turbo -p 3000",
    "dev:web:webpack": "next dev -p 3000",
    "dev:server": "tsx watch --exclude ./src/app --exclude ./.next --exclude ./server/dist server/src/dev-index.ts",
    "build": "node init && next build --turbo && npm run build:server",
    "build:webpack": "next build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node init && concurrently -n web,api -c cyan,magenta \"npm run start:web\" \"npm run start:server\"",
    "start:web": "next start -p 3000",
    "start:server": "node scripts/start.cjs"
  },
